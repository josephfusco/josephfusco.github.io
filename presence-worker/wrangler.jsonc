{
  "name": "presence",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "PresenceRoom" }, { "name": "LOBBY", "class_name": "PresenceLobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }, { "tag": "v2", "new_sqlite_classes": ["PresenceLobby"] }],
  "routes": [
    { "pattern": "josephfus.co/ws*", "zone_name": "josephfus.co" },
    { "pattern": "josephfus.co/wp-activity", "zone_name": "josephfus.co" }
  ],
  "observability": { "enabled": true }
}
